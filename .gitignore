# =============================================================================
# TitanSafe — .gitignore
# Based on the IBM Bob AI Hackathon submission template
# =============================================================================

# ── Secrets & Environment ─────────────────────────────────────────────────────
.env
.env.local
.env.production
*.key
*.pem
*.p12
secrets/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
venv/
.venv/
env/
pip-log.txt
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.coverage
htmlcov/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Windows ───────────────────────────────────────────────────────────────────
Thumbs.db
desktop.ini

# ── IDEs & Editors ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── Generated outputs (run `TitanSafe demo` to regenerate) ──────────────────
out/
out_*/

# ── Large demo media (use demo/demo-video-link.txt instead) ──────────────────
demo/*.mp4
demo/*.mov
demo/*.avi
demo/*.mkv

# ── Docker volumes / local data ───────────────────────────────────────────────
data/
logs/
*.log

# ── Terraform ─────────────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.backup
